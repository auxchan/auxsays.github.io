{
  "name": "@auxsays/systems-monitor-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node scripts/clean-generated.mjs",
    "build": "npm run clean && npm run typecheck && vite build && node scripts/validate-manifest.mjs && node scripts/measure-performance.mjs && node scripts/compose-jekyll.mjs",
    "verify:site": "node scripts/verify-static-site.mjs",
    "licenses": "node scripts/generate-license-inventory.mjs",
    "validate": "npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
